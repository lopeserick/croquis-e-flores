# Modelo das variáveis de ambiente. Copie para .env.local e preencha.
# NUNCA versione o .env.local nem coloque valores reais neste arquivo.
#
# O e-mail que recebe os pedidos e o WhatsApp da artista NÃO ficam aqui:
# são configurados pelo painel administrativo.

# --- Site ---
# URL pública, sem barra no final. Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (painel do projeto > Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (sb_publishable_...). Pode chegar ao navegador; o acesso é limitado pelas políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...). SOMENTE no servidor: ignora as políticas RLS.
# Copie a chave inteira (no painel, clique em "Reveal"; a versão mascarada não funciona).
SUPABASE_SECRET_KEY=
# Usadas pela CLI do Supabase (migrations) e pelos testes de banco, não pelo site.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- E-mail (Resend) ---
# Sem a chave, o pedido é gravado normalmente e fica com o e-mail marcado como "falhou"
# (o painel mostra e o envio pode ser refeito).
RESEND_API_KEY=
# Remetente. Em produção, um endereço do domínio verificado no Resend.
# Antes de verificar o domínio, use: Croquis e Flores <onboarding@resend.dev>
EMAIL_FROM="Croquis e Flores <pedidos@seu-dominio.com.br>"
# Só em desenvolvimento: manda todo e-mail para este endereço (o Resend sem domínio
# verificado só entrega ao e-mail do dono da conta). Deixe vazio em produção.
EMAIL_TO_OVERRIDE=

# --- Segurança ---
# Protege a rota do cron da Vercel. Gere com: openssl rand -hex 32
CRON_SECRET=
# Sal para guardar IPs apenas como hash (LGPD). Gere com: openssl rand -hex 32
IP_HASH_SALT=
