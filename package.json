{
  "name": "croquis-e-flores",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:push": "node scripts/db.mjs db push --remote",
    "db:seed": "node scripts/db.mjs db query --remote -f supabase/seed.sql",
    "db:types": "node scripts/db.mjs gen types --lang typescript --linked > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
